FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Añadimos la variable de la API (importante el prefijo PUBLIC_ para SvelteKit)
ARG PUBLIC_API_URL
ARG PUBLIC_AUTH0_DOMAIN_MGN
ARG PUBLIC_AUTH0_CLIENT_ID_MGN

ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV PUBLIC_AUTH0_DOMAIN_MGN=$PUBLIC_AUTH0_DOMAIN_MGN
ENV PUBLIC_AUTH0_CLIENT_ID_MGN=$PUBLIC_AUTH0_CLIENT_ID_MGN

RUN npm run build
EXPOSE 80
ENV HOST=0.0.0.0
ENV PORT=80
CMD ["node", "build/index.js"]