    {
      "name": "Get Country & Year Range",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Filtro de país correcto\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var expectedCountry = pm.request.url.query.get(\"country\");\r",
              "    \r",
              "    jsonData.forEach(function(item) {\r",
              "        pm.expect(item.country).to.eql(expectedCountry);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Filtro de año mínimo correcto\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var from = parseInt(pm.request.url.query.get(\"from\"));\r",
              "\r",
              "    jsonData.forEach(function(item) {\r",
              "        pm.expect(item.year).to.be.at.least(from);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
