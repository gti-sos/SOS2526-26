    {
      "name": "Get Year Range",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Devuelve un array de resultados\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Los datos están dentro del rango solicitado\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var from = parseInt(pm.request.url.query.get(\"from\"));\r",
              "    var to = parseInt(pm.request.url.query.get(\"to\"));\r",
              "\r",
              "    jsonData.forEach(function(item) {\r",
              "        pm.expect(item.year).to.be.at.least(from);\r",
              "        pm.expect(item.year).to.be.at.most(to);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
